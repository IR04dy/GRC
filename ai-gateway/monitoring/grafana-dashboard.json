      "id": 9,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "Upstream Token Consumption (Prompt vs Completion Tokens) & Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ai_gateway_tokens_prompt_total",
          "legendFormat": "Prompt Tokens",
          "refId": "A"
