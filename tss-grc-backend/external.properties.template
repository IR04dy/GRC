# ============================================================================
# TSS GRC Platform — EXTERNAL configuration (lives NEXT TO the jar)
#
# Loaded via spring.config.import (application.yml). Edit + restart the
# service to apply — no rebuild needed. Two kinds of entries work here:
#   1. The UPPER_CASE names below — they feed the ${PLACEHOLDER} references
#      inside the packaged application*.yml files.
#   2. Any raw Spring key (e.g. grc.cors.allowed-origins=...) — full override.
#
# This file contains secrets: restrict it to Administrators/SYSTEM
#   icacls C:\tss-grc\app\external.properties /inheritance:r /grant:r "Administrators:F" "SYSTEM:F"
# ============================================================================

# ── Security (REQUIRED) ─────────────────────────────────────────────────────
# >= 32 chars; must NOT contain "change-this" or "placeholder" (boot fails).
# Generate: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=REPLACE-ME-64-CHAR-RANDOM-SECRET

# Optional 24h rotation overlap (docs/operations/jwt-secret-rotation.md)
#JWT_SECRET_PREVIOUS=

# Token lifetimes (defaults: access 15 min, refresh 7 days)
#JWT_ACCESS_EXPIRY_MS=900000
#JWT_REFRESH_EXPIRY_MS=604800000

# ── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:sqlserver://localhost\\SQLEXPRESS;databaseName=TSS_GRC;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true
DB_USERNAME=grc_app
DB_PASSWORD=REPLACE-ME-DB-PASSWORD

# ── Flyway (restored-DB deployment) ─────────────────────────────────────────
# The restored TSS_GRC already carries every migration up to V292. Baseline
# there so only FUTURE migrations (V293+) auto-apply at startup.
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=292

# ── HTTP (behind the nginx reverse proxy) ───────────────────────────────────
# nginx terminates on :80 and proxies to the backend on loopback:8084.
SERVER_PORT=8084
SERVER_SSL_ENABLED=false
SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8090
MANAGEMENT_SERVER_ADDRESS=127.0.0.1

# When you later terminate TLS in the app itself instead of nginx:
#SERVER_PORT=8443
#SERVER_SSL_ENABLED=true
#SSL_KEYSTORE_PATH=C:/tss-grc/app/keystore.p12
#SSL_KEYSTORE_PASSWORD=

# ── Paths (Windows) ─────────────────────────────────────────────────────────
LOGGING_FILE_NAME=C:/tss-grc/logs/application.log
FILE_STORAGE_PATH=C:/tss-grc/data/uploads

# ── Mail (notifications) ────────────────────────────────────────────────────
# Replace with your real SMTP relay to enable e-mail delivery.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=noreply
SMTP_PASSWORD=unused
NOTIFY_FROM_EMAIL=noreply@tss-grc.com

# ── Health probes for optional infrastructure (OFF by default) ──────────────
# Flip ON once a real LDAP directory / SMTP relay is wired, so /actuator/health
# starts guarding them too.
#LDAP_HEALTH_ENABLED=true
#MAIL_HEALTH_ENABLED=true

# ── Schema validation (OFF: long-lived DB mixes smallint/bit on is_deleted) ─
#HIBERNATE_DDL_AUTO=validate

# ── Optional integrations (all OFF by default) ──────────────────────────────
#SENTRY_DSN=
#CORS_ALLOWED_ORIGINS=            # empty = same-origin only (nginx proxy) — leave unset
#SERVICENOW_CLIENT_ID=
#SERVICENOW_CLIENT_SECRET=
#SPLUNK_HEC_TOKEN=
#CROWDSTRIKE_CLIENT_ID=
#CROWDSTRIKE_CLIENT_SECRET=
#TENABLE_ACCESS_KEY=
#TENABLE_SECRET_KEY=

# ── Audit-ledger tamper-evidence (F2-31) ────────────────────────────────────
# HMAC key for platform.audit_log's hash chain. It belongs HERE and NOT in the
# database: that separation IS the control — a database-only compromise (SQL
# injection, a stolen `sa` password, a DBA without filesystem access) cannot
# forge a valid chain. Leave it unset and the chain falls back to plain SHA-256,
# which still detects modification and mid-chain deletion but can be recomputed
# by anyone with database write access; every /api/v1/audit-log/integrity
# response reports which mode is in force.
#
# >=32 chars, no "change-this"/"placeholder" text, or it is refused and logged.
# ⚠ Rotating it does not raise a false tamper alarm — each row records the
# algorithm it was sealed under — but be precise about what rotation costs:
# rows sealed under the OLD key become UNVERIFIABLE, not verified. The endpoint
# then answers PARTIALLY_VERIFIED with verified=false, tamperDetected=false and
# an exact count, because claiming verified=true over rows it could not check is
# how an integrity report comes to mislead an examiner. Re-sealing them under
# the new key is deliberately NOT offered: it would overwrite the only evidence
# those rows have. Rotate only with a reason, and keep the old key archived.
#
# ⚠ What this does not cover, stated plainly: truncation of the newest rows is
# undetectable from inside the same database, and an actor holding BOTH this
# file and the database can recompute the chain. On a deployment where the DBA,
# platform admin and deployment operator are one person, this is deterrence and
# evidence-of-effort. Separate key custody is what makes it prevention.
#AUDIT_INTEGRITY_KEY=
#AUDIT_SEALING_ENABLED=true
#AUDIT_SEAL_INTERVAL_MS=300000
