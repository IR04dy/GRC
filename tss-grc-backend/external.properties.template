# ============================================================================
# TSS GRC Platform — EXTERNAL configuration (lives NEXT TO the jar)
#
# Loaded via spring.config.import (application.yml). Edit + restart the
# service to apply — no rebuild needed.
#
# ⚠ ONLY THE UPPER_CASE NAMES BELOW WORK. This header used to say a raw Spring
# key such as `grc.cors.allowed-origins=...` was a "full override". THAT IS FALSE,
# and it cost four days of wrong belief about a P0 (F2-149):
#
#   * The UPPER_CASE names feed ${PLACEHOLDER} references inside the packaged
#     application*.yml files. A placeholder resolves from ANY property source at
#     ANY precedence, so these always win. Set them freely.
#
#   * A raw Spring property path is SILENTLY IGNORED whenever a profile-specific
#     file also sets it. This file arrives through `spring.config.import` in
#     application.yml, and application-prod.yml outranks application.yml and
#     everything it imports. On 2026-08-02 an operator wrote
#     `grc.security.tenant-write-guard.enabled=false` here to mitigate a P0 and it
#     had no effect at all — production kept booting with the guard ON, logging
#     "[TenantWriteGuard] interceptor WIRED", while the finding recorded it as OFF.
#     No error. No warning. The switch simply was not connected to anything.
#
# So: if you need to change something that has no UPPER_CASE name here, do not
# invent a raw key — add the placeholder to the yml and the name to this file.
# ExternalConfigOverrideContractTest fails the build if the two drift apart.
#
# This file contains secrets: restrict it to Administrators/SYSTEM
#   icacls C:\tss-grc\app\external.properties /inheritance:r /grant:r "Administrators:F" "SYSTEM:F"
# ============================================================================

# ── Security (REQUIRED) ─────────────────────────────────────────────────────
# >= 32 chars; must NOT contain "change-this" or "placeholder" (boot fails).
# Generate: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=REPLACE-ME-64-CHAR-RANDOM-SECRET

# Optional 24h rotation overlap (docs/operations/jwt-secret-rotation.md)
#JWT_SECRET_PREVIOUS=

# Token lifetimes (defaults: access 15 min, refresh 7 days)
#JWT_ACCESS_EXPIRY_MS=900000
#JWT_REFRESH_EXPIRY_MS=604800000

# ── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:sqlserver://localhost\\SQLEXPRESS;databaseName=TSS_GRC;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true
DB_USERNAME=grc_app
DB_PASSWORD=REPLACE-ME-DB-PASSWORD

# ── Flyway (restored-DB deployment) ─────────────────────────────────────────
# ⚠ THIS NUMBER IS NOT A CONSTANT, AND IT IS THE MOST DANGEROUS VALUE IN THIS
# FILE. It must equal the newest migration ALREADY PRESENT in the backup you
# restored. Flyway then records a baseline there and applies only what is above
# it. Set it LOWER and Flyway replays every migration in between against objects
# that already exist, and the startup dies part-way with the schema half-applied.
#
# This template read a flat `292` for months. That was correct for the 2026-07-11
# backup and is wrong for any backup taken since: the tree is at V399, so a
# database copied today needs 399. A dev-sourced backup carries NO
# flyway_schema_history at all (dev applies migrations by hand with Flyway off),
# so there is nothing in the database to correct a wrong value here.
#
# The mechanism was verified end to end on 2026-09-03, at the head of that day:
# a V398 backup restored to a scratch database with this value set to 398 logged
# "Successfully baselined schema with version: 398", then "Schema [platform] is
# up to date. No migration necessary.", and zero "Migrating schema" lines. What
# was verified is the RULE -- baseline at the head the backup carries -- so the
# number above tracks the tree while that observation stays at 398.
#
# After the first boot, confirm with /actuator/info -- packagedHead, appliedHead
# and an empty `pending` list are the check that this value was right.
FLYWAY_BASELINE_ON_MIGRATE=true
FLYWAY_BASELINE_VERSION=399

# ── HTTP (behind the nginx reverse proxy) ───────────────────────────────────
# nginx terminates on :80 and proxies to the backend on loopback:8084.
SERVER_PORT=8084
SERVER_SSL_ENABLED=false
SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8090
MANAGEMENT_SERVER_ADDRESS=127.0.0.1

# When you later terminate TLS in the app itself instead of nginx:
#SERVER_PORT=8443
#SERVER_SSL_ENABLED=true
#SSL_KEYSTORE_PATH=C:/tss-grc/app/keystore.p12
#SSL_KEYSTORE_PASSWORD=

# ── Paths (Windows) ─────────────────────────────────────────────────────────
LOGGING_FILE_NAME=C:/tss-grc/logs/application.log
FILE_STORAGE_PATH=C:/tss-grc/data/uploads

# ── Mail (notifications) ────────────────────────────────────────────────────
# Replace with your real SMTP relay to enable e-mail delivery.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=noreply
SMTP_PASSWORD=unused
NOTIFY_FROM_EMAIL=noreply@tss-grc.com

# ── Health probes for optional infrastructure (OFF by default) ──────────────
# Flip ON once a real LDAP directory / SMTP relay is wired, so /actuator/health
# starts guarding them too.
#LDAP_HEALTH_ENABLED=true
#MAIL_HEALTH_ENABLED=true

# ── Schema validation (OFF: long-lived DB mixes smallint/bit on is_deleted) ─
#HIBERNATE_DDL_AUTO=validate

# ── Optional integrations (all OFF by default) ──────────────────────────────
#SENTRY_DSN=
#CORS_ALLOWED_ORIGINS=            # empty = same-origin only (nginx proxy) — leave unset
#SERVICENOW_CLIENT_ID=
#SERVICENOW_CLIENT_SECRET=
#SPLUNK_HEC_TOKEN=
#CROWDSTRIKE_CLIENT_ID=
#CROWDSTRIKE_CLIENT_SECRET=
#TENABLE_ACCESS_KEY=
#TENABLE_SECRET_KEY=

# ── Audit-ledger tamper-evidence (F2-31) ────────────────────────────────────
# HMAC key for platform.audit_log's hash chain. It belongs HERE and NOT in the
# database: that separation IS the control — a database-only compromise (SQL
# injection, a stolen `sa` password, a DBA without filesystem access) cannot
# forge a valid chain. Leave it unset and the chain falls back to plain SHA-256,
# which still detects modification and mid-chain deletion but can be recomputed
# by anyone with database write access; every /api/v1/audit-log/integrity
# response reports which mode is in force.
#
# >=32 chars, no "change-this"/"placeholder" text, or it is refused and logged.
# ⚠ Rotating it does not raise a false tamper alarm — each row records the
# algorithm it was sealed under — but be precise about what rotation costs:
# rows sealed under the OLD key become UNVERIFIABLE, not verified. The endpoint
# then answers PARTIALLY_VERIFIED with verified=false, tamperDetected=false and
# an exact count, because claiming verified=true over rows it could not check is
# how an integrity report comes to mislead an examiner. Re-sealing them under
# the new key is deliberately NOT offered: it would overwrite the only evidence
# those rows have. Rotate only with a reason, and keep the old key archived.
#
# ⚠ What this does not cover, stated plainly: truncation of the newest rows is
# undetectable from inside the same database, and an actor holding BOTH this
# file and the database can recompute the chain. On a deployment where the DBA,
# platform admin and deployment operator are one person, this is deterrence and
# evidence-of-effort. Separate key custody is what makes it prevention.
#AUDIT_INTEGRITY_KEY=
#AUDIT_SEALING_ENABLED=true
#AUDIT_SEAL_INTERVAL_MS=300000
#AUDIT_SEAL_INITIAL_DELAY_MS=60000

# ── Runtime kill-switches (F2-149) ───────────────────────────────────
# Every one of these was a literal `true` inside application-prod.yml, so no
# operator could turn it off without a rebuild. They are placeholders now, and
# these are the names. All default to ON in prod — uncomment only to stop
# something that is misbehaving, and record why.
#
# TENANT_WRITE_GUARD_ENABLED is the Hibernate-level cross-tenant write backstop.
# It is defence-in-depth: the per-service setOrganisationId() stamps remain the
# primary control, so turning it off degrades assurance rather than opening a
# hole. This is the switch that did not work on 2026-08-02.
#TENANT_WRITE_GUARD_ENABLED=true
# The four SLA/expiry clocks. Turning one off stops reminders and overdue
# escalations for that module — which is a compliance gap on NCA/SAMA reviews,
# not merely a quiet inbox.
#VULN_SLA_SCHEDULER_ENABLED=true
#CYBER_CAPA_SLA_SCHEDULER_ENABLED=true
#CYBER_EVIDENCE_EXPIRY_SCHEDULER_ENABLED=true
#WORKFLOW_REQUEST_SLA_SCHEDULER_ENABLED=true

# ── Storage, schema and API surface ─────────────────────────────
# STORAGE_BASE_PATH is the base-profile default; prod reads FILE_STORAGE_PATH
# above. Both exist, and they are different keys — set the one your profile uses.
#STORAGE_BASE_PATH=./uploads
# Flyway's history-table schema. Changing it on a live deployment orphans the
# existing history and re-runs everything: do not.
#FLYWAY_DEFAULT_SCHEMA=platform
# Swagger is OFF in prod by design (it publishes the whole API surface).
#SWAGGER_ENABLED=false

# ── SQL Server Express capacity monitor ────────────────────────
# Express caps a database at 10 GB. These are the warn/alert/halt thresholds in
# MB and the check cadence. HALT stops non-essential writes — it is the last
# line before the engine refuses everything.
#GRC_DB_SIZE_WARN_MB=7168
#GRC_DB_SIZE_ALERT_MB=9216
#GRC_DB_SIZE_HALT_MB=9728
#GRC_DB_SIZE_CHECK_CRON=0 0 */6 * * *

# ── BCM economics ────────────────────────────────────────
# Discount rate (percent) behind BCP/DRP return-on-investment figures. It feeds
# numbers a board sees, so change it deliberately and note the source.
#GRC_BCM_ROI_DISCOUNT_RATE=8.00

# ── Error tracking / connectors (optional) ──────────────────────
#SENTRY_ENV=prod
#SENTRY_RELEASE=tss-grc-platform@0.1.0-SNAPSHOT
#SERVICENOW_USERNAME=
#SERVICENOW_PASSWORD=
#SERVICENOW_TOKEN_URL=
#SPLUNK_WEBHOOK_SECRET=
